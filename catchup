#!/usr/bin/env bash
# Source-checkout convenience launcher. Installed users run `catchup` directly.
set -eu
CATCHUP_SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$CATCHUP_SOURCE_DIR/venv/bin/python3" ]; then
  CATCHUP_PYTHON="$CATCHUP_SOURCE_DIR/venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
  CATCHUP_PYTHON="$(command -v python3)"
else
  echo "catchup: Python 3.10+ is required for source installs. See README.md." >&2
  exit 1
fi
# Never change the caller's directory: relative input paths belong to the caller.
export PYTHONPATH="$CATCHUP_SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$CATCHUP_PYTHON" -m catchmeup "$@"
