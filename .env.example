# Get a key at https://console.anthropic.com/settings/keys
# Then run: ./catchup config
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default recap style when you don't pass one:
#   meeting  = work Zoom / standup / 1:1
#   lecture  = class / seminar / recorded lecture
# Override per file: ./catchup meeting FILE   or   ./catchup lecture FILE
CATCHMEUP_MODE=meeting
