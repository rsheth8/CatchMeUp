# CatchMeUp — bring your own key from any company
#
#   ./catchup config openai
#   ./catchup config anthropic
#   ./catchup config gemini
#   ./catchup providers          # full list
#
# No cloud key? Local notes on your Mac:
#   ./catchup config ollama
#   ollama pull qwen3.6:35b
#
# Optional overrides:
# CATCHMEUP_MODEL=gpt-4.1-mini
# CATCHMEUP_BASE_URL=https://your-company.example/v1

# CATCHMEUP_CLOSED=1          # exam mode: ask/think refuse if not in notes
# CATCHMEUP_AUDIO_DEVICE=0     # ffmpeg AVFoundation mic index (./catchup rec --devices)
# CATCHMEUP_SYNC=0             # don't auto-push recaps to the iPhone
# CATCHMEUP_SYNC_DIR=          # override (default: the app's iCloud Drive folder)
# CATCHMEUP_SYNC_AUDIO=1       # include archived audio on auto-push

CATCHMEUP_PROVIDER=anthropic
CATCHMEUP_API_KEY=your-key-here
CATCHMEUP_MODEL=
CATCHMEUP_BASE_URL=
CATCHMEUP_MODE=meeting
