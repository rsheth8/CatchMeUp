cmd_rec() {
  local mode="" brain="" keep=0 device="" seconds="" fake=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --devices|-l|--list-devices)
        header "Microphones"
        run_python "$PROJECT_DIR/record.py" --devices
        return
        ;;
      --keep|--no-recap) keep=1; shift ;;
      --fake) fake=1; shift ;;
      --device|-d)
        device="${2:-}"
        shift 2 || true
        ;;
      -t|--seconds)
        seconds="${2:-}"
        shift 2 || true
        ;;
      --help|-h)
        err "Usage: ./catchup rec [meeting|lecture|brain] [--keep] [--device N]"
        echo "    ./catchup rec                 # default mode, then recap"
        echo "    ./catchup rec lecture         # class recap after Ctrl-C"
        echo "    ./catchup rec cs61a           # into that brain's inbox/"
        echo "    ./catchup rec --devices       # list mics"
        echo "    ./catchup rec --keep          # save the file, skip recap"
        exit 0
        ;;
      *)
        if is_brain "$1"; then
          brain="$1"
          shift
        elif [[ -n "$(normalize_mode "$1")" ]]; then
          mode="$(normalize_mode "$1")"
          shift
        else
          err "Unknown rec argument: $1"
          echo "    ./catchup rec --help"
          exit 1
        fi
        ;;
    esac
  done
  if [[ -n "$brain" && -z "$mode" ]]; then
    mode="$(run_python -c "import brains; print(brains.load_brain('$brain')['kind'])")"
  fi
  [[ -z "$mode" ]] && mode="$(default_mode)"
  ensure_dirs
  local dest stamp
  stamp="$(date +%Y%m%d_%H%M%S)"
  if [[ -n "$brain" ]]; then
    mkdir -p "$DATA_DIR/brains/$brain/inbox"
    dest="$DATA_DIR/brains/$brain/inbox/rec-${stamp}.m4a"
  else
    dest="$RECORDINGS_DIR/rec-${stamp}.m4a"
  fi
  header "Record · ${mode}${brain:+ · $brain}"
  local rec_args=(-o "$dest")
  [[ -n "$device" ]] && rec_args+=(--device "$device")
  [[ -n "$seconds" ]] && rec_args+=(--seconds "$seconds")
  [[ -n "$brain" ]] && rec_args+=(--brain "$brain")
  [[ "$fake" -eq 1 ]] && rec_args+=(--fake)
  run_python "$PROJECT_DIR/record.py" "${rec_args[@]}"
  if [[ ! -f "$dest" ]]; then
    err "No recording written."
    exit 1
  fi
  ok "Saved $(basename "$dest")"
  if [[ "$keep" -eq 1 ]]; then
    echo "    Recap later: ./catchup ${mode} \"$dest\""
    return
  fi
  if [[ -n "$brain" ]]; then
    cmd_into "$brain" "$dest"
  else
    cmd_recap "$mode" "$dest"
  fi
}

