#!/usr/bin/env bash
# catchup — CatchMeUp CLI: meeting + lecture recordings → Word notes
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

export CATCHMEUP_HOME="${CATCHMEUP_HOME:-$PROJECT_DIR}"
DATA_DIR="$CATCHMEUP_HOME"

PYTHON="$PROJECT_DIR/venv/bin/python3"
RECORDINGS_DIR="$DATA_DIR/recordings"
OUTPUT_DIR="$DATA_DIR/output"
PROCESSED_DIR="$DATA_DIR/processed"
LOGS_DIR="$DATA_DIR/logs"
if [[ -f "$DATA_DIR/.env" ]]; then
  ENV_FILE="$DATA_DIR/.env"
else
  ENV_FILE="$PROJECT_DIR/.env"
fi
LOCK_DIR="$LOGS_DIR/watch.lock.d"
WATCH_LABEL="com.rsheth8.catchmeup.watch"
WATCH_PLIST="$HOME/Library/LaunchAgents/${WATCH_LABEL}.plist"

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ -z "${CATCHMEUP_PLAIN:-}" ]]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  CYAN=$'\033[36m'
  MAGENTA=$'\033[35m'
  RESET=$'\033[0m'
else
  BOLD="" DIM="" GREEN="" YELLOW="" RED="" CYAN="" MAGENTA="" RESET=""
fi

ok()   { echo "${GREEN}✓${RESET} $*"; }
warn() { echo "${YELLOW}!${RESET} $*"; }
err()  { echo "${RED}✗${RESET} $*" >&2; }
info() { echo "${CYAN}→${RESET} $*"; }
header() {
  echo
  if [[ -t 1 && -z "${NO_COLOR:-}" && -z "${CATCHMEUP_PLAIN:-}" ]]; then
    echo "${CYAN}▁▂▃▅▇${RESET} ${BOLD}$*${RESET} ${CYAN}▇▅▃▂▁${RESET}"
  else
    echo "${BOLD}$*${RESET}"
  fi
  echo "${DIM}$(printf '─%.0s' {1..46})${RESET}"
}

usage() {
  local art=""
  if python_ok || have python3; then
    art="$(run_python -c "import viz; print(viz.banner())" 2>/dev/null || true)"
  fi
  if [[ -n "$art" ]]; then
    printf '%s\n\n' "$art"
  else
    echo "${BOLD}CatchMeUp${RESET}  ${DIM}missed the Zoom. missed lecture. still got the notes.${RESET}"
    echo
    echo "  ${DIM}recording → ffmpeg → whisperkit-cli → your LLM → notes${RESET}"
    echo
  fi
  cat <<EOF
  ${CYAN}./catchup help${RESET}            this list
  ${CYAN}./catchup help exam${RESET}       details for one command
  ${CYAN}./catchup demo${RESET}            live terminal play-through
  ${CYAN}./catchup demo --web${RESET}      clickable graph in the browser

${BOLD}Start${RESET}
  setup                 Install ffmpeg, whisperkit-cli, Python, .env
  doctor                Check that everything is ready
  demo                  Live terminal play-through (wave, rec, cortex)
  demo --web            Same demo as a clickable graph in the browser
  providers             Companies whose API keys we accept
  config [COMPANY]      Paste an API key (openai, anthropic, gemini, …)
  model MODEL           Override that company's default model
  mode meeting|lecture  Default recap style

${BOLD}Recap${RESET}
  meeting FILE          Work Zoom / standup / 1:1
  lecture FILE          Class / seminar
  rec [meeting|lecture] Record from the mic, then recap  (Ctrl-C to stop)
  rec --devices         List microphones
  drop FILE             Copy a file into recordings/
  watch meeting|lecture Auto-recap new files in recordings/

${BOLD}Brains${RESET}  ${DIM}one specialist per subject or team${RESET}
  brain new NAME [--lecture|--meeting]
  brain list | show NAME | persona NAME
  into NAME FILE|DIR    Recap a recording (or a whole folder) into that brain
  rec NAME              Record into that brain's inbox, then recap
  ask NAME QUESTION     RAG over that brain only
  think NAME TASK       Deep multi-pass analysis
  walk NAME [CONCEPT]   Open a concept in this app (hop / clip / graph)
  notes NAME            List every concept note in a brain
  graph NAME [CONCEPT]  Open CatchMeUp's own clickable graph
  trace NAME A B        Shortest path between two ideas
  exam NAME             Practice exam from its recaps
  diff NAME             What changed since the last recap
  clip NAME WORDS       Play the audio of a concept
  cortex NAME [WORDS]   Concept graph; words light up a node
  watch NAME            Watch that brain's inbox/
  mcp install           Let Cursor talk to your brains

${BOLD}Library${RESET}  ${DIM}everything you've already recapped${RESET}
  library               List recaps
  search WORDS          Find a topic
  ask QUESTION          Ask across all recaps
  quiz                  Flashcards from lecture terms
  todos                 Action items from meetings
  moments               Timestamps from the latest recap
  play HH:MM:SS         Hear 25s of that moment
  clip WORDS            Jump to a concept's audio

${BOLD}Housekeeping${RESET}
  status                Pending files, latest notes, watcher
  list                  Notes in output/
  logs                  Recent log  (logs -f to follow)
  open                  Open output/ in Finder
  obsidian NAME         Optional vault dump (you don't need Obsidian)
  install-watch meeting|lecture     Background watcher
  uninstall-watch

${DIM}Examples${RESET}
  ./catchup meeting ~/Desktop/standup.mov
  ./catchup lecture ~/Downloads/cs61a-week3.mp4
  ./catchup exam cs61a --print
  ./catchup clip cs61a mutex
  ./catchup cortex cs61a mutex
  ./catchup walk cs61a mutex
  ./catchup graph cs61a
  ./catchup rec lecture
  ./catchup demo
EOF
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    ""|help|-h|--help|commands|cmds) usage ;;
    *) help_topic "$topic" ;;
  esac
}

help_topic() {
  local topic="$1"
  case "$topic" in
    setup)
      header "help · setup"
      cat <<EOF
First-time install: Homebrew packages, Python venv, .env.

  ./catchup setup
  ./catchup doctor          # confirm it's ready
EOF
      ;;
    doctor)
      header "help · doctor"
      cat <<EOF
Checks macOS, Homebrew, ffmpeg, whisperkit-cli, Python, API key, folders.

  ./catchup doctor
EOF
      ;;
    config|providers|provider|model|mode)
      header "help · config"
      cat <<EOF
Bring your own API key. Transcription stays on-device.

  ./catchup providers
  ./catchup config openai          # or anthropic, gemini, groq, …
  ./catchup model gpt-4.1-mini
  ./catchup mode lecture           # default when you don't pass meeting/lecture
EOF
      ;;
    meeting|lecture|recap|work|class)
      header "help · meeting / lecture"
      cat <<EOF
Turn one recording into Word + Markdown notes.

  ./catchup meeting ~/Desktop/standup.mov
  ./catchup lecture ~/Downloads/week3.mp4
  ./catchup FILE                   # shortcut; mode guessed from the name

Meetings also label speakers (Speaker 1, Speaker 2, …).
EOF
      ;;
    rec|record|mic)
      header "help · rec"
      cat <<EOF
Record from the Mac microphone, then recap. Ctrl-C stops.

  ./catchup rec --devices
  ./catchup rec lecture
  ./catchup rec meeting
  ./catchup rec cs61a              # into that brain's inbox/
  ./catchup rec --keep             # save the file, skip recap
  ./catchup rec --device 0

Needs microphone permission for Terminal / iTerm.
EOF
      ;;
    drop|watch|install-watch|uninstall-watch)
      header "help · drop / watch"
      cat <<EOF
Drop-box for a week of recordings.

  ./catchup drop ~/Downloads/week4.m4a
  ./catchup watch lecture          # recordings/ as classes
  ./catchup watch meeting
  ./catchup watch cs61a            # brains/cs61a/inbox/
  ./catchup install-watch lecture  # same, via launchd
  ./catchup uninstall-watch
EOF
      ;;
    brain|brains|into)
      header "help · brain"
      cat <<EOF
A folder specialist: one subject or one team. RAG cannot leave that folder.

  ./catchup brain new cs61a --lecture
  ./catchup brain new acme-client --meeting
  ./catchup brain list
  ./catchup brain persona cs61a You are a CS 61A TA.
  ./catchup into cs61a ~/Downloads/week3.mp4
  ./catchup into mit-60001 MIT-6.0001/     # whole course folder; skips ones you already filed
  ./catchup ask cs61a what is a mutex
EOF
      ;;
    ask|search|library|quiz|todos|moments|play)
      header "help · library"
      cat <<EOF
Query recaps you already have (no new recording needed).

  ./catchup library
  ./catchup search mutex
  ./catchup ask what did we decide about billing
  ./catchup ask cs61a explain environment diagrams
  ./catchup quiz
  ./catchup todos
  ./catchup moments
  ./catchup play 00:12:40
EOF
      ;;
    think|analyze|cortex|walk|trace|notes|graph|obsidian|vault)
      header "help · cortex / walk / graph"
      cat <<EOF
CatchMeUp is the reader. You do not need Obsidian (or any other notes app).

  ./catchup notes cs61a            # list concepts
  ./catchup walk cs61a mutex       # open one; hop by name or 1-9
  ./catchup graph cs61a            # clickable graph in your browser
  ./catchup graph cs61a mutex      # same, focused on that idea
  ./catchup cortex cs61a           # ASCII map in the terminal
  ./catchup trace cs61a mutex heaps
  ./catchup think cs61a explain mutexes for the midterm
  ./catchup cortex cs61a --rebuild

Optional extra — dump a vault if you already use Obsidian:

  ./catchup obsidian cs61a
EOF
      ;;
    demo|splash|viz)
      header "help · demo"
      cat <<EOF
Terminal identity. In a real terminal this plays: waveform, rec meter, pipeline, cortex lighting up.

  ./catchup demo
  ./catchup demo --web               # clickable graph (watch this one)
  CATCHMEUP_PLAIN=1 ./catchup demo   # ASCII still (pipes / CI)
EOF
      ;;
    exam|midterm|test)
      header "help · exam"
      cat <<EOF
Practice test from that brain's terms, study list, and key moments.

  ./catchup exam cs61a             # type answers; q to quit
  ./catchup exam cs61a --print     # dump the test
  ./catchup exam cs61a --print --answers
  ./catchup exam cs61a -n 6
EOF
      ;;
    diff|drift)
      header "help · diff"
      cat <<EOF
What changed between the two latest recaps in a brain (or the whole library).

  ./catchup diff cs61a             # new / dropped terms and topics
  ./catchup diff acme-client       # action items opened vs closed
EOF
      ;;
    clip|hear)
      header "help · clip"
      cat <<EOF
Find a concept and play 25 seconds of the archived audio.

  ./catchup clip cs61a mutex
  ./catchup clip billing
  ./catchup clip cs61a mutex --print    # show the timestamp, don't play
EOF
      ;;
    mcp)
      header "help · mcp"
      cat <<EOF
Expose brains to Cursor / Claude Desktop.

  ./catchup mcp install
  ./catchup mcp                # stdio server (usually started by the editor)
EOF
      ;;
    status|list|logs|log|open)
      header "help · status"
      cat <<EOF
  ./catchup status             pending files, latest notes, watcher
  ./catchup list               Word / Markdown notes in output/
  ./catchup logs               last log lines
  ./catchup logs -f            follow
  ./catchup open               open output/ in Finder
EOF
      ;;
    *)
      err "No help page for '$topic'."
      echo "    ./catchup help              full command list"
      echo "    ./catchup help exam         example of a command page"
      exit 1
      ;;
  esac
}

ensure_dirs() {
  mkdir -p "$RECORDINGS_DIR" "$OUTPUT_DIR" "$PROCESSED_DIR" "$LOGS_DIR" "$DATA_DIR/brains"
}

have() { command -v "$1" >/dev/null 2>&1; }

load_env() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
  fi
}

python_ok() {
  [[ -x "$PYTHON" ]]
}

normalize_mode() {
  local raw="${1:-}"
  case "$raw" in
    meeting|work|zoom|job|office) echo meeting ;;
    lecture|class|lesson|school|uni|college) echo lecture ;;
    "") echo "" ;;
    *) echo "" ;;
  esac
}

default_mode() {
  load_env
  local m
  m="$(normalize_mode "${CATCHMEUP_MODE:-}")"
  echo "${m:-meeting}"
}

write_env() {
  load_env
  local key="${1:-${CATCHMEUP_API_KEY:-${ANTHROPIC_API_KEY:-}}}"
  local mode="${2:-${CATCHMEUP_MODE:-meeting}}"
  local provider="${3:-${CATCHMEUP_PROVIDER:-anthropic}}"
  local model="${4:-${CATCHMEUP_MODEL:-}}"
  local base="${5:-${CATCHMEUP_BASE_URL:-}}"
  mode="$(normalize_mode "$mode")"
  [[ -z "$mode" ]] && mode="meeting"
  [[ -z "$provider" ]] && provider="anthropic"
  {
    printf 'CATCHMEUP_PROVIDER=%s\n' "$provider"
    printf 'CATCHMEUP_API_KEY=%s\n' "$key"
    printf 'CATCHMEUP_MODEL=%s\n' "$model"
    printf 'CATCHMEUP_BASE_URL=%s\n' "$base"
    printf 'CATCHMEUP_MODE=%s\n' "$mode"
    case "$provider" in
      anthropic) printf 'ANTHROPIC_API_KEY=%s\n' "$key" ;;
      openai)    printf 'OPENAI_API_KEY=%s\n' "$key" ;;
      gemini)    printf 'GEMINI_API_KEY=%s\n' "$key" ;;
      groq)      printf 'GROQ_API_KEY=%s\n' "$key" ;;
      openrouter) printf 'OPENROUTER_API_KEY=%s\n' "$key" ;;
      deepseek)  printf 'DEEPSEEK_API_KEY=%s\n' "$key" ;;
      mistral)   printf 'MISTRAL_API_KEY=%s\n' "$key" ;;
      together)  printf 'TOGETHER_API_KEY=%s\n' "$key" ;;
      xai)       printf 'XAI_API_KEY=%s\n' "$key" ;;
    esac
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

is_brain() {
  [[ -n "${1:-}" && -f "$DATA_DIR/brains/$1/brain.json" ]]
}

known_provider() {
  [[ -n "$(normalize_provider "${1:-}")" ]]
}

normalize_provider() {
  local raw
  raw="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
  case "$raw" in
    claude) echo anthropic ;;
    gpt|chatgpt) echo openai ;;
    google|google-ai) echo gemini ;;
    grok) echo xai ;;
    local) echo ollama ;;
    anthropic|openai|gemini|groq|openrouter|deepseek|mistral|together|xai|ollama|custom) echo "$raw" ;;
    *) echo "" ;;
  esac
}

media_in() {
  local dir="$1"
  local f
  shopt -s nullglob
  for f in "$dir"/*.mov "$dir"/*.mp4 "$dir"/*.m4a "$dir"/*.mp3 "$dir"/*.wav "$dir"/*.aac "$dir"/*.mkv "$dir"/*.webm; do
    printf '%s\n' "$f"
  done
  shopt -u nullglob
}

cmd_setup() {
  header "Setup"

  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "This project is set up for macOS (WhisperKit + Homebrew)."
    exit 1
  fi

  if ! have brew; then
    err "Homebrew is not installed."
    echo "    Install it from https://brew.sh then run ./catchup setup again."
    exit 1
  fi
  ok "Homebrew"

  info "Installing the two audio packages this project needs:"
  echo "    ${BOLD}brew install ffmpeg${RESET}          # convert recordings to mp3"
  echo "    ${BOLD}brew install whisperkit-cli${RESET}  # transcribe on-device (Apple Silicon)"
  if have ffmpeg; then
    ok "ffmpeg already installed"
  else
    brew install ffmpeg
  fi
  if have whisperkit-cli; then
    ok "whisperkit-cli already installed"
  else
    brew install whisperkit-cli
  fi
  ok "ffmpeg $(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')"
  ok "whisperkit-cli ($(command -v whisperkit-cli))"

  if ! have python3; then
    err "python3 not found. Install it with: brew install python"
    exit 1
  fi

  if [[ ! -x "$PYTHON" ]]; then
    info "Creating Python virtualenv at venv/"
    python3 -m venv "$PROJECT_DIR/venv"
  fi
  info "Installing Python packages"
  "$PYTHON" -m pip install --upgrade pip >/dev/null
  "$PYTHON" -m pip install -r "$PROJECT_DIR/requirements.txt"
  ok "Python venv + anthropic + openai + python-docx"

  ensure_dirs
  ok "Folders: recordings/  output/  processed/  logs/"

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$PROJECT_DIR/.env.example" "$ENV_FILE"
    echo
    warn "No .env yet — paste an API key from any supported company."
    echo "    List them: ./catchup providers"
    cmd_config
  else
    ok ".env already present"
  fi

  echo
  if cmd_doctor; then
    echo
    echo "${GREEN}${BOLD}You're set.${RESET} Work or school:"
    echo "  ./catchup meeting /path/to/standup.mov"
    echo "  ./catchup lecture /path/to/cs-week3.mp4"
  else
    echo
    warn "Setup finished, but doctor still has items to fix (see above)."
  fi
}

cmd_providers() {
  header "API keys we accept"
  if python_ok || have python3; then
    run_python "$PROJECT_DIR/providers.py" --list
  else
    cat <<'EOF'
anthropic     Anthropic (Claude)
openai        OpenAI (GPT)
gemini        Google (Gemini)
groq          Groq
openrouter    OpenRouter (one key, many models)
deepseek      DeepSeek
mistral       Mistral
together      Together AI
xai           xAI (Grok)
ollama        Ollama (local, no cloud key)
custom        Custom OpenAI-compatible API
EOF
  fi
}

provider_signup() {
  case "$1" in
    anthropic) echo "https://console.anthropic.com/settings/keys" ;;
    openai) echo "https://platform.openai.com/api-keys" ;;
    gemini) echo "https://aistudio.google.com/apikey" ;;
    groq) echo "https://console.groq.com/keys" ;;
    openrouter) echo "https://openrouter.ai/keys" ;;
    deepseek) echo "https://platform.deepseek.com/api_keys" ;;
    mistral) echo "https://console.mistral.ai/api-keys" ;;
    together) echo "https://api.together.ai/settings/api-keys" ;;
    xai) echo "https://console.x.ai/" ;;
    ollama) echo "https://ollama.com" ;;
    custom) echo "(your company's OpenAI-compatible endpoint)" ;;
  esac
}

cmd_config() {
  header "Bring your own API key"
  load_env
  local provider="" key="" model="" base=""
  if [[ -n "${1:-}" ]] && known_provider "$1"; then
    provider="$(normalize_provider "$1")"
    shift || true
  elif [[ -n "${1:-}" && "$1" == sk-ant-* ]]; then
    provider="anthropic"
  fi

  if [[ -z "$provider" ]]; then
    cmd_providers
    echo
    printf "Company id (openai, anthropic, gemini, …): "
    read -r provider
    provider="$(normalize_provider "$provider")"
  fi
  if [[ -z "$provider" ]]; then
    err "Unknown company. Run ./catchup providers"
    exit 1
  fi

  local signup
  signup="$(provider_signup "$provider")"
  info "Using ${BOLD}$provider${RESET}"
  [[ -n "$signup" ]] && echo "    Get a key: ${CYAN}${signup}${RESET}"

  if [[ "$provider" == "custom" ]]; then
    if [[ -n "${1:-}" && "$1" == http* ]]; then
      base="$1"
      shift || true
    else
      printf "Base URL (https://…/v1): "
      read -r base
    fi
    if [[ -z "$base" ]]; then
      err "custom provider needs CATCHMEUP_BASE_URL"
      exit 1
    fi
  fi

  if [[ "$provider" == "ollama" ]]; then
    key="ollama"
    ok "Ollama does not need a cloud key (talks to http://127.0.0.1:11434)"
  elif [[ -n "${1:-}" ]]; then
    key="$1"
  else
    printf "Paste API key: "
    read -r key
  fi
  if [[ -z "$key" ]]; then
    err "No key entered."
    echo "    You can also edit .env by hand. See .env.example."
    exit 1
  fi

  if [[ -t 0 ]]; then
    printf "Model [blank = provider default]: "
    read -r model || true
  fi

  write_env "$key" "$(default_mode)" "$provider" "$model" "$base"
  ok "Saved $provider to .env (gitignored — do not send this file)"
  echo "    Recap with: ./catchup meeting FILE   or   ./catchup lecture FILE"
}

cmd_model() {
  local model="${1:-}"
  if [[ -z "$model" ]]; then
    err "Usage: ./catchup model <model-id>"
    echo "    Example: ./catchup model gpt-4.1-mini"
    echo "    Example: ./catchup model claude-sonnet-4-5"
    exit 1
  fi
  load_env
  write_env "${CATCHMEUP_API_KEY:-${ANTHROPIC_API_KEY:-}}" "$(default_mode)" \
    "${CATCHMEUP_PROVIDER:-anthropic}" "$model" "${CATCHMEUP_BASE_URL:-}"
  ok "Model override is now ${BOLD}$model${RESET}"
}

cmd_mode() {
  local mode
  mode="$(normalize_mode "${1:-}")"
  if [[ -z "$mode" ]]; then
    err "Usage: ./catchup mode meeting|lecture"
    echo "    meeting  = work Zoom / standup / 1:1"
    echo "    lecture  = class / seminar / recorded lecture"
    exit 1
  fi
  load_env
  write_env "${CATCHMEUP_API_KEY:-${ANTHROPIC_API_KEY:-}}" "$mode" \
    "${CATCHMEUP_PROVIDER:-anthropic}" "${CATCHMEUP_MODEL:-}" "${CATCHMEUP_BASE_URL:-}"
  ok "Default recap style is now ${BOLD}$mode${RESET}"
  echo "    Override any time: ./catchup meeting FILE   or   ./catchup lecture FILE"
}

cmd_doctor() {
  header "Doctor"
  local failed=0

  if [[ "$(uname -s)" == "Darwin" ]]; then
    ok "macOS"
  else
    warn "Not macOS — WhisperKit and notifications may not work"
    failed=1
  fi

  if have brew; then
    ok "Homebrew  $(brew --prefix)"
  else
    err "Homebrew missing — https://brew.sh"
    failed=1
  fi

  if have ffmpeg; then
    ok "ffmpeg     $(command -v ffmpeg)"
  else
    err "ffmpeg missing"
    echo "    ${BOLD}brew install ffmpeg${RESET}"
    failed=1
  fi

  if have whisperkit-cli; then
    ok "whisperkit-cli  $(command -v whisperkit-cli)"
  else
    err "whisperkit-cli missing"
    echo "    ${BOLD}brew install whisperkit-cli${RESET}"
    failed=1
  fi

  if have python3; then
    ok "python3    $(python3 --version 2>&1)"
  else
    err "python3 missing — brew install python"
    failed=1
  fi

  if python_ok; then
    ok "venv       $PYTHON"
    if "$PYTHON" -c "import anthropic, openai, docx" 2>/dev/null; then
      ok "Python packages (anthropic, openai, python-docx)"
    else
      err "Python packages missing — run ./catchup setup"
      failed=1
    fi
  elif have python3; then
    warn "venv missing — using system python3 (run ./catchup setup for an isolated venv)"
    if python3 -c "import anthropic, openai, docx" 2>/dev/null; then
      ok "Python packages (anthropic, openai, python-docx)"
    else
      err "Python packages missing — run ./catchup setup"
      failed=1
    fi
  else
    err "python3 missing — brew install python"
    failed=1
  fi

  load_env
  local provider
  provider="$(normalize_provider "${CATCHMEUP_PROVIDER:-anthropic}")"
  [[ -z "$provider" ]] && provider="anthropic"
  local key="${CATCHMEUP_API_KEY:-${ANTHROPIC_API_KEY:-${OPENAI_API_KEY:-${GEMINI_API_KEY:-${GROQ_API_KEY:-}}}}}"
  if [[ "$provider" == "ollama" ]]; then
    ok "Provider   ollama (local)"
  elif [[ -n "$key" && "$key" != "sk-ant-your-key-here" && "$key" != "your-key-here" ]]; then
    ok "Provider   $provider  (API key is set)"
  else
    err "No API key — run ./catchup config $provider"
    echo "    See companies: ./catchup providers"
    failed=1
  fi
  if [[ -n "${CATCHMEUP_MODEL:-}" ]]; then
    info "Model      $CATCHMEUP_MODEL"
  fi

  info "Default mode: $(default_mode)  (change with ./catchup mode lecture|meeting)"

  ensure_dirs
  ok "Folders exist"

  if launchctl list "$WATCH_LABEL" >/dev/null 2>&1; then
    ok "Background watcher is loaded ($WATCH_LABEL)"
  else
    info "Background watcher not installed (optional: ./catchup install-watch meeting|lecture)"
  fi

  echo
  if [[ "$failed" -eq 0 ]]; then
    echo "${GREEN}${BOLD}All good.${RESET}"
    if python_ok || have python3; then
      run_python -c "import viz; print(viz.ok_wave())" 2>/dev/null || true
    fi
    return 0
  else
    echo "${RED}${BOLD}Fix the items above, then run ./catchup doctor again.${RESET}"
    return 1
  fi
}

cmd_recap() {
  local mode="" file=""
  while [[ $# -gt 0 ]]; do
    local maybe
    maybe="$(normalize_mode "$1")"
    if [[ -n "$maybe" && -z "$file" ]]; then
      mode="$maybe"
      shift
      continue
    fi
    file="$1"
    shift
  done
  if [[ -z "$file" ]]; then
    err "Usage: ./catchup meeting <file>   or   ./catchup lecture <file>"
    exit 1
  fi
  if [[ ! -f "$file" ]]; then
    err "File not found: $file"
    exit 1
  fi
  if ! python_ok && ! have python3; then
    err "Run ./catchup setup first."
    exit 1
  fi
  [[ -z "$mode" ]] && mode=""
  load_env
  ensure_dirs
  if [[ -n "$mode" ]]; then
    header "CatchMeUp · ${mode}"
    info "$(basename "$file")"
    run_python "$PROJECT_DIR/pipeline.py" --mode "$mode" "$file"
  else
    header "CatchMeUp"
    info "$(basename "$file")  (mode guessed from name / default)"
    run_python "$PROJECT_DIR/pipeline.py" "$file"
  fi
  echo
  ok "Notes are in ${BOLD}output/${RESET}"
  ls -1t "$OUTPUT_DIR"/*.docx 2>/dev/null | head -3 || true
}

cmd_drop() {
  local file="${1:-}"
  if [[ -z "$file" ]]; then
    err "Usage: ./catchup drop <recording-file>"
    exit 1
  fi
  if [[ ! -f "$file" ]]; then
    err "File not found: $file"
    exit 1
  fi
  ensure_dirs
  local dest="$RECORDINGS_DIR/$(basename "$file")"
  if [[ "$(cd "$(dirname "$file")" && pwd)/$(basename "$file")" == "$dest" ]]; then
    ok "Already in recordings/: $(basename "$file")"
    return 0
  fi
  cp "$file" "$dest"
  ok "Copied to recordings/$(basename "$file")"
  echo "    Work:    ./catchup meeting \"$dest\""
  echo "    School:  ./catchup lecture \"$dest\""
  echo "    Watch:   ./catchup watch meeting   or   ./catchup watch lecture"
}

cmd_watch() {
  local mode="" brain=""
  if is_brain "${1:-}"; then
    brain="$1"
    shift || true
    mode="$(normalize_mode "${1:-}")"
    if [[ -z "$mode" ]]; then
      mode="$(run_python -c "import brains; print(brains.load_brain('$brain')['kind'])")"
    fi
  else
    mode="$(normalize_mode "${1:-}")"
    [[ -z "$mode" ]] && mode="$(default_mode)"
  fi
  if ! python_ok && ! have python3; then
    err "Run ./catchup setup first."
    exit 1
  fi
  ensure_dirs
  if [[ -n "$brain" ]]; then
    mkdir -p "$DATA_DIR/brains/$brain/inbox"
    header "Watching brains/${brain}/inbox  (${mode})"
  else
    header "Watching ${RECORDINGS_DIR}  (${mode})"
  fi
  echo "Drop .mov .mp4 .m4a .mp3 .wav files — Ctrl-C to stop."
  echo
  local interval=8
  while true; do
    if [[ -n "$brain" ]]; then
      "$PROJECT_DIR/watch_and_process.sh" "$mode" "$brain" || true
    else
      "$PROJECT_DIR/watch_and_process.sh" "$mode" || true
    fi
    sleep "$interval"
  done
}

cmd_status() {
  ensure_dirs
  header "Status"
  info "Default mode: $(default_mode)"

  local pending
  pending="$(media_in "$RECORDINGS_DIR")"
  if [[ -z "$pending" ]]; then
    ok "recordings/ is empty (nothing waiting)"
  else
    warn "Waiting in recordings/:"
    echo "$pending" | while IFS= read -r f; do
      echo "    $(basename "$f")"
    done
  fi

  echo
  local notes
  notes="$(ls -1t "$OUTPUT_DIR"/*.docx 2>/dev/null || true)"
  if [[ -z "$notes" ]]; then
    info "No notes in output/ yet"
  else
    ok "Latest notes:"
    echo "$notes" | head -5 | while IFS= read -r f; do
      echo "    $(basename "$f")"
    done
  fi

  echo
  if launchctl list "$WATCH_LABEL" >/dev/null 2>&1; then
    ok "Background watcher is running"
  else
    info "Background watcher is off"
  fi

  if [[ -d "$LOCK_DIR" ]]; then
    warn "A run is in progress (lock present)"
  fi

  if [[ -f "$LOGS_DIR/pipeline.log" ]]; then
    echo
    echo "${DIM}Last log lines:${RESET}"
    tail -n 8 "$LOGS_DIR/pipeline.log" | sed 's/^/    /'
  fi
}

cmd_list() {
