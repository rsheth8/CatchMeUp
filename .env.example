# CatchMeUp — bring your own key from any company
#
#   ./catchup config openai
#   ./catchup config anthropic
#   ./catchup config gemini
#   ./catchup providers          # full list
#
# Optional overrides:
# CATCHMEUP_MODEL=gpt-4.1-mini
# CATCHMEUP_BASE_URL=https://your-company.example/v1

CATCHMEUP_PROVIDER=anthropic
CATCHMEUP_API_KEY=your-key-here
CATCHMEUP_MODEL=
CATCHMEUP_BASE_URL=
CATCHMEUP_MODE=meeting
