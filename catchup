cmd_into() {
  local slug="${1:-}"
  local src="${2:-}"
  if [[ -z "$slug" || -z "$src" ]]; then
    err "Usage: ./catchup into <brain> <recording-file-or-folder>"
    exit 1
  fi
  if ! is_brain "$slug"; then
    err "No brain named $slug. Create it: ./catchup brain new $slug --lecture"
    exit 1
  fi
  if [[ ! -e "$src" ]]; then
    err "Not found: $src"
    exit 1
  fi
  load_env
  local kind
  kind="$(run_python -c "import brains; print(brains.load_brain('$slug')['kind'])")"
  if [[ -d "$src" ]]; then
    header "Into ${slug}  (${kind}, folder)"
    info "$src"
    run_python "$PROJECT_DIR/pipeline.py" --mode "$kind" --brain "$slug" "$src"
    ok "Folder pass done.  ./catchup notes $slug   ·  ./catchup graph $slug"
    return
  fi
  header "Into ${slug}  (${kind})"
  info "$(basename "$src")"
  run_python "$PROJECT_DIR/pipeline.py" --mode "$kind" --brain "$slug" "$src"
  ok "Filed into brains/${slug}/  — ask it: ./catchup ask $slug <question>"
}

cmd_mcp() {
  local sub="${1:-run}"
  case "$sub" in
    install)
      header "MCP for Cursor"
      mkdir -p "$PROJECT_DIR/.cursor"
      local py
      if python_ok; then py="$PYTHON"; else py="$(command -v python3)"; fi
      cat > "$PROJECT_DIR/.cursor/mcp.json" <<EOF
{
  "mcpServers": {
    "catchmeup": {
      "command": "${py}",
      "args": ["${PROJECT_DIR}/mcp_server.py"]
    }
  }
}
EOF
      ok "Wrote .cursor/mcp.json for this project"
      echo "    Restart Cursor (or reload MCP) then ask:"
      echo "    “Using CatchMeUp, list brains and ask cs61a about heaps.”"
      echo
      echo "    User-wide: copy mcp.json.example into Cursor MCP settings"
      echo "    and replace REPLACE_WITH_ABSOLUTE_PATH with:"
      echo "    $PROJECT_DIR"
      ;;
    run)
      if python_ok; then
        exec "$PYTHON" "$PROJECT_DIR/mcp_server.py"
      else
        exec python3 "$PROJECT_DIR/mcp_server.py"
      fi
      ;;
    *)
      err "Usage: ./catchup mcp install   or   ./catchup mcp run"
      exit 1
      ;;
  esac
}

cmd_uninstall_watch() {
  if [[ -f "$WATCH_PLIST" ]]; then
    launchctl unload "$WATCH_PLIST" 2>/dev/null || true
    rm -f "$WATCH_PLIST"
    ok "Background watcher removed"
  else
    info "Watcher was not installed"
  fi
}

main() {
  local cmd="${1:-help}"
  # Shortcut: ./catchup recording.mov  (uses default / guessed mode)
  if [[ -n "$cmd" && -f "$cmd" ]]; then
    cmd_recap "$@"
    return
  fi
  shift || true
  case "$cmd" in
    help|-h|--help|commands|cmds) cmd_help "$@" ;;
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    config) cmd_config "$@" ;;
    providers|provider) cmd_providers "$@" ;;
    model) cmd_model "$@" ;;
    mode) cmd_mode "$@" ;;
    meeting|work|zoom) cmd_recap meeting "$@" ;;
    lecture|class|lesson) cmd_recap lecture "$@" ;;
    recap|transcribe|run|process) cmd_recap "$@" ;;
    drop|add) cmd_drop "$@" ;;
    watch) cmd_watch "$@" ;;
    status) cmd_status "$@" ;;
    list) cmd_list "$@" ;;
    library|history) cmd_library "$@" ;;
    search|find) cmd_search "$@" ;;
    ask) cmd_ask "$@" ;;
    think|analyze|reason) cmd_think "$@" ;;
    cortex) cmd_cortex "$@" ;;
    walk|neuron) cmd_walk "$@" ;;
    notes|note) cmd_notes "$@" ;;
    graph|web|map) cmd_graph "$@" ;;
    obsidian|vault) cmd_obsidian "$@" ;;
    trace|path) cmd_trace "$@" ;;
    demo|splash|viz) cmd_demo "$@" ;;
    quiz|flashcards) cmd_quiz "$@" ;;
    exam|midterm|test) cmd_exam "$@" ;;
    diff|drift) cmd_diff "$@" ;;
    todos|todo|actions) cmd_todos "$@" ;;
    moments|bookmarks) cmd_moments "$@" ;;
    play|jump) cmd_play "$@" ;;
    clip|hear) cmd_clip "$@" ;;
    rec|record|mic) cmd_rec "$@" ;;
    brain|brains) cmd_brain "$@" ;;
    into|file-into) cmd_into "$@" ;;
    mcp) cmd_mcp "$@" ;;
    logs|log) cmd_logs "$@" ;;
    open) cmd_open "$@" ;;
    install-watch) cmd_install_watch "$@" ;;
    uninstall-watch) cmd_uninstall_watch "$@" ;;
    *)
      err "Unknown command: $cmd"
      echo "    ./catchup help              all commands"
      echo "    ./catchup help $cmd         if you meant a topic"
      echo
      usage
      exit 1
      ;;
  esac
}

main "$@"
