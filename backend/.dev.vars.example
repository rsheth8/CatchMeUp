# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
# Load the key from the macOS Keychain, do not paste it into chat or history:
#   printf 'ANTHROPIC_API_KEY=%s\n' "$(secret get ANTHROPIC_API_KEY)" > .dev.vars
#   printf 'SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" >> .dev.vars
ANTHROPIC_API_KEY=
SESSION_SECRET=
